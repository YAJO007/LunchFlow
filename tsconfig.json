{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "types": ["node"],
    "outDir": "./dist",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "database", "frontend"]
}
